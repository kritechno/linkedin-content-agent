# ── LinkedIn OAuth (Phase 0) ──────────────────────────────────────────────
# Create an app at https://www.linkedin.com/developers/apps
# Enable products: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URL in your app's Auth tab:
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback
# Scopes requested at consent. openid+profile give us the person URN; w_member_social lets us post.
LINKEDIN_SCOPES=openid profile w_member_social
# Versioned API header (YYYYMM). Bump to a currently-supported version when LinkedIn rotates it.
LINKEDIN_API_VERSION=202506

# ── LLM / draft writer (Phase 2) ──────────────────────────────────────────
# Provider: "openai" or "anthropic".
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override; blank = provider default (openai→gpt-5.5, anthropic→claude-sonnet-4-6)
# LLM_MODEL=
# OpenAI GPT-5-class reasoning effort: none|low|medium|high|xhigh (default low —
# enough for a short voiced post, keeps drafts fast). Ignored by older models.
# OPENAI_REASONING_EFFORT=low
# VOICE_SAMPLES_DIR=voice_examples
# N_ANGLES=3
# GROUND_WITH_ARTICLE=true        # fetch a source excerpt to ground the draft

# ── Telegram review (Phase 3) ─────────────────────────────────────────────
# Bot token from @BotFather; chat id from @userinfobot (only this chat is obeyed).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Images (Phase 5) ──────────────────────────────────────────────────────
# IMAGE_DEFAULT=false             # attach a text-card/chart by default?
# IMAGE_DIR=generated_images

# ── Scheduling / polish (Phase 6) ─────────────────────────────────────────
# POST_DAYS=mon,wed,fri
# POST_HOUR=8
# TOPIC_MEMORY_DAYS=30            # how long before a topic can resurface
# TOPICS_PER_CYCLE=1              # how many drafts to send per run
# MAX_POSTS_PER_WEEK=4

# ── Storage ───────────────────────────────────────────────────────────────
DB_PATH=linkedin_agent.db

# ── Research (Phase 1) ────────────────────────────────────────────────────
# Comma-separated. Override defaults if you want to widen/narrow the net.
# RESEARCH_QUERIES=LLM,AI agent,vibe coding,Claude,GPT,AI engineering
# RESEARCH_MAX_AGE_HOURS=72
